{
  "ConnectionStrings": {
    "PostgreSQL": ""
  },
  "Jwt": {
    "Issuer": "EventLens.Api",
    "Audience": "EventLens.Web",
    "Key": "",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
